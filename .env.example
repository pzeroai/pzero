# ─── LLM Provider ────────────────────────────────────────────
# API key for your LLM provider
LLM_API_KEY=sk-your-api-key-here

# Base URL for the LLM API
# OpenAI (default):    https://api.openai.com/v1
# LiteLLM proxy:       http://localhost:4000/v1
# Ollama:              http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model identifier
# OpenAI:     gpt-4o, gpt-4o-mini
# Anthropic:  claude-sonnet-4-5-20250929 (via LiteLLM)
# Ollama:     llama3 (local, free)
LLM_MODEL=gpt-4o

# ─── Data ────────────────────────────────────────────────────
# Path to directory containing Kalshi + Polymarket parquet files
# Expected structure: DATA_DIR/{kalshi,polymarket}/{markets,trades,...}/
DATA_DIR=./data

# ─── Indexer (Polymarket blockchain) ───────────────────────
# Polygon RPC endpoint (required for Polymarket trades/blocks indexers)
# Public:  https://polygon-rpc.com
# Alchemy: https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC=

# Block number where Polymarket CTF Exchange was deployed (default: 33605403)
# POLYMARKET_START_BLOCK=33605403

# Polymarket trades fetch concurrency (default: 4)
# PM_TRADES_FETCH_CONCURRENCY=4

# Polymarket trades block chunk size (default: 1000)
# PM_TRADES_CHUNK_SIZE=1000

# Log progress every N committed chunks (default: 1)
# PM_TRADES_PROGRESS_LOG_EVERY=1

# Emit waiting heartbeat if no chunk commits for this duration (default: 30000ms)
# PM_TRADES_STALL_HEARTBEAT_MS=30000

# ─── Indexer (Kalshi API) ───────────────────────────────────
# Shared Kalshi API rate limit guard (default: 80 requests / 10 seconds)
# KALSHI_RATE_LIMIT_MAX_REQUESTS=80
# KALSHI_RATE_LIMIT_WINDOW_MS=10000

# Kalshi markets discovery
# KALSHI_MARKETS_PAGE_LIMIT=1000
# KALSHI_MARKETS_OVERLAP_SECONDS=300
# KALSHI_MARKETS_PROGRESS_LOG_EVERY=1
# Log cursor suffix every N pages (default: 20)
# KALSHI_MARKETS_CURSOR_LOG_EVERY=20
# Optional hard cap for created_time in seconds since epoch
# KALSHI_MARKETS_MAX_CREATED_TS=
# Maximum allowed future skew for created-time watermark (default: 0 seconds)
# Prevents far-future created_time outliers from pinning discovery.
# KALSHI_MARKETS_WATERMARK_MAX_FUTURE_SECONDS=0
# One-time lookback (seconds) when migrating old close-time checkpoints to created-time
# KALSHI_MARKETS_MIGRATION_LOOKBACK_SECONDS=86400

# Kalshi trades indexing
# KALSHI_TRADES_OVERLAP_SECONDS=120
# KALSHI_TRADES_FLUSH_SIZE=10000
# KALSHI_TRADES_FLUSH_INTERVAL_MS=30000
# KALSHI_TRADES_PROGRESS_LOG_EVERY=10
